{
  "__inputs": [{"name": "DS_LOKI", "label": "Loki", "type": "datasource", "pluginId": "loki", "pluginName": "Loki"}],
  "title": "Drone Konsolu",
  "uid": "drone-konsol",
  "time": {"from": "now-6h", "to": "now"},
  "refresh": "5s",
  "schemaVersion": 39,
  "panels": [
    {"type": "stat", "title": "Kamera Girdisi", "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
     "datasource": {"type": "loki", "uid": "${DS_LOKI}"},
     "targets": [{"refId": "A", "queryType": "instant", "expr": "sum(count_over_time({job=\"drone\", event=\"camera_input\"}[$__range]))"}]},
    {"type": "stat", "title": "Karar Bekleyen", "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
     "datasource": {"type": "loki", "uid": "${DS_LOKI}"},
     "targets": [{"refId": "A", "queryType": "instant", "expr": "sum(count_over_time({job=\"drone\", event=\"awaiting_decision\"}[$__range]))"}]},
    {"type": "stat", "title": "Drone Uçuşu", "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
     "datasource": {"type": "loki", "uid": "${DS_LOKI}"},
     "targets": [{"refId": "A", "queryType": "instant", "expr": "sum(count_over_time({job=\"drone\", event=\"drone_dispatched\"}[$__range]))"}]},
    {"type": "piechart", "title": "Kararlar (yes/no)", "gridPos": {"x": 18, "y": 0, "w": 6, "h": 8},
     "datasource": {"type": "loki", "uid": "${DS_LOKI}"},
     "targets": [{"refId": "A", "queryType": "instant", "legendFormat": "{{decision}}", "expr": "sum by (decision) (count_over_time({job=\"drone\", event=\"final_decision\"} | json [$__range]))"}]},
    {"type": "timeseries", "title": "Bölgelere Göre Sapmalar", "gridPos": {"x": 0, "y": 4, "w": 18, "h": 8},
     "datasource": {"type": "loki", "uid": "${DS_LOKI}"},
     "targets": [{"refId": "A", "legendFormat": "{{target_zone}}", "expr": "sum by (target_zone) (count_over_time({job=\"drone\", event=\"awaiting_decision\"} | json [1m]))"}]},
    {"type": "table", "title": "Fotoğraflar", "gridPos": {"x": 0, "y": 12, "w": 8, "h": 12},
     "datasource": {"type": "loki", "uid": "${DS_LOKI}"},
     "targets": [{"refId": "A", "expr": "{job=\"drone\", event=\"awaiting_decision\"} | json | photo != \"\" | line_format \"http://localhost:5000/frames/{{.photo}}\""}],
     "fieldConfig": {"defaults": {"custom": {"cellOptions": {"type": "image"}}}}},
    {"type": "logs", "title": "Tüm Loglar", "gridPos": {"x": 8, "y": 12, "w": 16, "h": 12},
     "datasource": {"type": "loki", "uid": "${DS_LOKI}"},
     "targets": [{"refId": "A", "expr": "{job=\"drone\"} | json"}]}
  ]
}
