{"nodes": [{"id": "hackaton_project_handoff_grok", "label": "HANDOFF_GROK.md (passaggio di consegne)", "file_type": "document", "source_file": "Hackaton_project/HANDOFF_GROK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Diario del progetto per Grok o chi continua: stato attuale, storia delle versioni, decisioni, problemi aperti. Marcature [sim] verificato in simulazione, [campo] visto sul drone vero, [ipotesi] non verificato."}, {"id": "hackaton_project_handoff_grok_progetto_finale_centrale", "label": "Progetto finale: centrale.py + dashboard", "file_type": "concept", "source_file": "Hackaton_project/HANDOFF_GROK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Un solo processo senza Flask (http.server): telecamere fisse -> allarme -> conferma Si/No in dashboard -> coda per priorita -> drone a 1,70 m al punto principale della zona -> 4 foto -> verdetto di Grok."}, {"id": "hackaton_project_handoff_grok_correzione_ritorno_pad", "label": "Correzione ritorno al pad (lungo e a sinistra)", "file_type": "concept", "source_file": "Hackaton_project/HANDOFF_GROK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Voli veri 09:40-09:53 del 5 nov: la distanza del volo continuo sommava velocita in dm/s interi (errore fino al 40%), rc 0 di frenata probabilmente perso nel Wi-Fi; dopo cw restavano 2-3 gradi a sinistra; il ToF in basso leggeva un oggetto e la ricerca del pad saliva a 1,4-1,6 m. Correzione: tratti con forward, muso entro 1 grado, ricerca del pad con h e max 1 m."}, {"id": "hackaton_project_handoff_grok_volo_continuo", "label": "Volo continuo con rc (tolto)", "file_type": "rationale", "source_file": "Hackaton_project/HANDOFF_GROK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tratti in rc a 50 cm/s con distanza dalle velocita integrate e taratura con forward 80: tolto il 5 nov perche la taratura cambiava da volo a volo (fattore 0,67-1,40) e un rc 0 perso lasciava il drone in moto."}, {"id": "hackaton_project_handoff_grok_taratura_forward", "label": "Taratura con il passo forward 80", "file_type": "concept", "source_file": "Hackaton_project/HANDOFF_GROK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "hackaton_project_handoff_grok_missione_semplice", "label": "Missione semplice: punto principale della zona, foto, ritorno", "file_type": "concept", "source_file": "Hackaton_project/HANDOFF_GROK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Richiesta di Andrea: niente avvicinamento alla persona; il drone va al punto hover della zona, fotografa e torna."}, {"id": "hackaton_project_handoff_grok_quattro_foto_90", "label": "4 foto a 90 gradi dallo stesso punto (quattro_lati)", "file_type": "concept", "source_file": "Hackaton_project/HANDOFF_GROK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "hackaton_project_handoff_grok_verdetto_grok", "label": "Verdetto di Grok: ANOMALY DETECTED / FALSO ALLARME / VERIFICA MANUALE", "file_type": "concept", "source_file": "Hackaton_project/HANDOFF_GROK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Grok riceve scena normale, fotogramma dell'allarme e 4 foto del drone; altro o errore = VERIFICA MANUALE."}, {"id": "hackaton_project_handoff_grok_allarme_cose_grandi", "label": "Allarme solo per cose grandi (macchia >= 3%, 0,5 s, diversa dal fondo)", "file_type": "concept", "source_file": "Hackaton_project/HANDOFF_GROK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "hackaton_project_handoff_grok_conferma_umana", "label": "Conferma umana prima di ogni decollo", "file_type": "rationale", "source_file": "Hackaton_project/HANDOFF_GROK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Decisione di sicurezza: nessun volo parte senza Si dell'operatore; --auto solo in simulazione."}, {"id": "hackaton_project_handoff_grok_coda_priorita", "label": "Coda delle missioni per priorita (manuale = 4), una missione alla volta", "file_type": "concept", "source_file": "Hackaton_project/HANDOFF_GROK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "hackaton_project_handoff_grok_stop_emergenza", "label": "STOP ed EMERGENZA (SPAZIO kill switch, BACKSPACE emergenza)", "file_type": "concept", "source_file": "Hackaton_project/HANDOFF_GROK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "hackaton_project_handoff_grok_soglie_batteria", "label": "Soglie batteria: 40% non parte, 30% torna, 20% atterra", "file_type": "concept", "source_file": "Hackaton_project/HANDOFF_GROK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "hackaton_project_handoff_grok_risposta_persa", "label": "Risposta persa nel Wi-Fi (attesa = durata prevista + 5 s)", "file_type": "concept", "source_file": "Hackaton_project/HANDOFF_GROK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Wi-Fi instabile: forward 80 senza risposta bloccava tutto per 20 s. Ora up/down/cw/ccw rimisurano dallo stato e continuano, gli altri comandi atterrano."}, {"id": "hackaton_project_handoff_grok_tof_guasto", "label": "ToF frontale guasto (legge 0) e --senza-tof", "file_type": "concept", "source_file": "Hackaton_project/HANDOFF_GROK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Il 5 nov il sensore leggeva sempre 0 anche con la mano davanti: tre 0 di fila = sensore guasto; --senza-tof vola ignorandolo solo per scelta esplicita."}, {"id": "hackaton_project_handoff_grok_lettore_video_morto", "label": "Lettore video di djitellopy morto: riavvio e fotogramma piu nitido", "file_type": "concept", "source_file": "Hackaton_project/HANDOFF_GROK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "hackaton_project_handoff_grok_qualita_foto", "label": "Qualita foto: nitidezza, blocchi H.264, luce; miglioramento leggero", "file_type": "concept", "source_file": "Hackaton_project/HANDOFF_GROK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CLAHE e gamma forte peggioravano le foto vere; il miglioramento vero richiede piu luce in sala."}, {"id": "hackaton_project_handoff_grok_quota_170", "label": "Volo a 1,70 m, pianta tagliata fino a 2,2 m (soppalchi vietati)", "file_type": "concept", "source_file": "Hackaton_project/HANDOFF_GROK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "hackaton_project_handoff_grok_punti_copertura", "label": "Punti di copertura e ordine del giro (vicino piu vicino + 2-opt)", "file_type": "concept", "source_file": "Hackaton_project/HANDOFF_GROK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "hackaton_project_handoff_grok_percorsi_larghi", "label": "Percorsi larghi: scorciatoie solo a 1 m dai muri (DISTANZA_COMODA_M)", "file_type": "concept", "source_file": "Hackaton_project/HANDOFF_GROK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prima bastavano 0,5 m e il tratto UNDER_MEZZ -> CENTER tagliava l'angolo del pilastro a 0,52 m."}, {"id": "hackaton_project_handoff_grok_vetrata", "label": "Vetrata tra ZONE_7 e porta B (ostacolo trasparente)", "file_type": "concept", "source_file": "Hackaton_project/HANDOFF_GROK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ostacolo per il volo ma non per la vista: linea_libera la ignora. Posizione stimata [ipotesi]."}, {"id": "hackaton_project_handoff_grok_ostacoli_extra", "label": "Ostacoli extra dal simulatore del team (parete x -1,60, pilastro 1 x 1 m)", "file_type": "concept", "source_file": "Hackaton_project/HANDOFF_GROK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Non presenti in PAD2.step, aggiunti per prudenza in sito.OSTACOLI_EXTRA; da verificare sul posto."}, {"id": "hackaton_project_handoff_grok_posto_operatore", "label": "Posto dell'operatore (tra 2 e 4 m dal pad, lontano dal percorso)", "file_type": "concept", "source_file": "Hackaton_project/HANDOFF_GROK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "hackaton_project_handoff_grok_zone", "label": "Zone di zones.json: HUB, ZONE_7, UNDER_MEZZ, CENTER, AISLE_EAST, NORTH_OPEN", "file_type": "concept", "source_file": "Hackaton_project/HANDOFF_GROK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prese dal repository del team (zone editor); unica modifica: la zona centrale PAD rinominata CENTER, il pad vero e in HUB."}, {"id": "hackaton_project_handoff_grok_pad_confermato", "label": "Pad confermato a (-0,75; 3,47), telefono 0,5 m dietro", "file_type": "concept", "source_file": "Hackaton_project/HANDOFF_GROK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "hackaton_project_handoff_grok_convenzioni_angoli", "label": "Convenzioni: angoli antiorari da +X (non lo yaw del team)", "file_type": "rationale", "source_file": "Hackaton_project/HANDOFF_GROK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "hackaton_project_handoff_grok_step_senza_cad", "label": "PAD2.step letto senza librerie CAD -> griglia 10 cm -> A*", "file_type": "concept", "source_file": "Hackaton_project/HANDOFF_GROK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "hackaton_project_handoff_grok_grok_dove_codice_come", "label": "Grok decide dove guardare, il codice decide come muoversi", "file_type": "rationale", "source_file": "Hackaton_project/HANDOFF_GROK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Grok restituisce giudizi in JSON; il codice valida i campi, calcola le coordinate, pianifica con A* e manda i comandi. ToF = misura, Grok = giudizio, codice = manovre e arresto."}, {"id": "hackaton_project_handoff_grok_lock_keepalive", "label": "Un lock per tutti i comandi + keepalive", "file_type": "rationale", "source_file": "Hackaton_project/HANDOFF_GROK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Il Tello atterra da solo dopo 15 s senza comandi, e due thread senza lock sfalsano le risposte [campo, 4 nov]."}, {"id": "hackaton_project_handoff_grok_chiave_xai", "label": "Chiave xAI in XAI_API_KEY o ~/chiave_xai.txt (la vecchia va revocata)", "file_type": "concept", "source_file": "Hackaton_project/HANDOFF_GROK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "hackaton_project_handoff_grok_deriva_posizione", "label": "Problema aperto: deriva della posizione (pad intermedi o ArUco)", "file_type": "concept", "source_file": "Hackaton_project/HANDOFF_GROK.md", "source_location": nu