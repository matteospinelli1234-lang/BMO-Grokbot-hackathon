  {
   "type": "table",
   "title": "Foto delle telecamere (allarmi)",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 33,
    "w": 9,
    "h": 12
   },
   "targets": [
    {
     "refId": "A",
     "expr": "{job=\"drone\", event=\"camera_input\"} | json | line_format \"http://localhost:5000/frames/{{.photo}}\""
    }
   ],
   "transformations": [
    {
     "id": "extractFields",
     "options": {
      "source": "labels",
      "format": "auto",
      "replace": false
     }
    },
    {
     "id": "organize",
     "options": {
      "includeByName": {
       "Time": true,
       "Line": true,
       "camera": true,
       "target_zone": true,
       "area_percento": true
      },
      "renameByName": {
       "Time": "Ora",
       "Line": "Foto",
       "target_zone": "Zona",
       "camera": "Telecamera",
       "lato": "Lato",
       "area_percento": "Area %",
       "luce": "Luce",
       "nitidezza": "Nitidezza"
      },
      "indexByName": {
       "Time": 0,
       "camera": 1,
       "target_zone": 2,
       "area_percento": 3,
       "Line": 4
      }
     }
    }
   ],
   "options": {
    "cellHeight": "lg",
    "showHeader": true,
    "sortBy": [
     {
      "displayName": "Ora",
      "desc": true
     }
    ]
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "left"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^(Foto|Line)$"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "image"
        }
       },
       {
        "id": "custom.width",
        "value": 170
       }
      ]
     }
    ]
